{
  "compilerOptions": {
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    // Add baseUrl, which is required for path aliases to work reliably
    "baseUrl": ".",
    "paths": {
      // This single alias is all you need for the src directory
      "@/*": ["./src/*"],
      "@/redux/*": ["./redux/*"]
    }
  },
  // This is the CORRECT include array that will fix your build
  "include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}